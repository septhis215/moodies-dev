// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Sentiment {
  positive
  neutral
  negative
}

enum TargetType {
  post
  comment
  review
}

enum MoodTag {
  happy
  angry
  sad
  excited
  curious
}

model User {
  id                 String      @id @default(uuid())
  username           String      @unique
  email              String      @unique
  password           String
  avatarUrl          String?
  age                Int?
  preferredGenres    String[]    @default([])
  preferredLanguages String[]    @default([])
  createdAt          DateTime    @default(now())
  Quiz               Quiz[]
  Badge              Badge[]
  Watchlist          Watchlist[]
}

model Quiz {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  answers    Json
  resultMood String
  createdAt  DateTime @default(now())
}

model Badge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeType String
  awardedAt DateTime @default(now())
}

model Watchlist {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  movieId  String[] @default([])
  seriesId String[] @default([])
  addedAt  DateTime @default(now())
}

model Series {
  id          String   @id @default(uuid())
  tmdbId      String   @unique
  title       String
  overview    String
  posterUrl   String?
  backdropUrl String?
  releaseDate String?
  genres      String[] @default([])
  rating      Float?
  moodTags    String[] @default([])
  createdAt   DateTime @default(now())
}

model Movie {
  id          String   @id @default(uuid())
  tmdbId      String   @unique
  title       String
  overview    String
  posterUrl   String?
  backdropUrl String?
  releaseDate String?
  genres      String[] @default([])
  rating      Float?
  moodTags    String[] @default([])
  createdAt   DateTime @default(now())
}

model Mood {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String
  icon        String
  description String
  keywords    String[]
  tmdbGenres  Int[]
  valence     Decimal  @db.Decimal(3, 2) @default(0)
  arousal     Decimal  @db.Decimal(3, 2) @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  logs            MoodLog[]
  recommendations Recommendation[]

  @@map("moods")
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  moodId    String
  intensity Int      @default(5)
  tags      String[]
  context   String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, moodId])
  @@map("mood_logs")
}

model Recommendation {
  id           String      @id @default(uuid())
  userId       String
  moodId       String
  tmdbId       Int
  mediaType    MediaType
  title        String
  overview     String?
  genreIds     Int[]
  voteAverage  Decimal     @db.Decimal(3, 2)
  voteCount    Int
  releaseDate  String?
  posterPath   String?
  backdropPath String?
  score        Decimal     @db.Decimal(4, 3)
  reason       String
  algorithm    String
  metadata     Json?
  viewed       Boolean     @default(false)
  liked        Boolean     @default(false)
  saved        Boolean     @default(false)
  rating       Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@index([userId, moodId])
  @@index([score])
  @@index([createdAt])
  @@index([tmdbId, mediaType])
  @@map("recommendations")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String
  preferredGenres  Int[]
  dislikedGenres   Int[]
  preferredMoods   String[]
  minRating        Decimal  @db.Decimal(3, 2) @default(6.0)
  preferredRuntime Json? // {min: number, max: number}
  languages        String[] @default(["en"])
  includeAdult     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId])
  @@map("user_preferences")
}

model ContentCache {
  id           String    @id @default(uuid())
  tmdbId       Int
  mediaType    MediaType
  title        String
  overview     String?
  genreIds     Int[]
  voteAverage  Decimal   @db.Decimal(3, 2)
  voteCount    Int
  releaseDate  String?
  posterPath   String?
  backdropPath String?
  popularity   Decimal   @db.Decimal(8, 3)
  adult        Boolean   @default(false)
  originalLanguage String
  metadata     Json?
  lastFetched  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tmdbId, mediaType])
  @@index([genreIds])
  @@index([voteAverage])
  @@index([popularity])
  @@index([lastFetched])
  @@map("content_cache")
}

model Post {
  id             String    @id @map("_id") @default(auto()) @db.ObjectId
  userId         String    @map("user_id") @db.ObjectId
  user           User?     @relation(fields: [userId], references: [id])
  movieId        String?   @map("movie_id")  @db.ObjectId
  seriesId       String?   @map("series_id") @db.ObjectId
  title          String
  content        String
  tags           String[]  @default([])
  mediaUrls      String[]  @map("media_urls") @default([])
  likeCount      Int       @map("like_count") @default(0)
  commentCount   Int       @map("comment_count") @default(0)
  sentimentScore Float?    @map("sentiment_score")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comments       PostComment[]

  @@index([userId])
  @@index([movieId])
  @@index([seriesId])
}

model PostComment {
  id             String    @id @map("_id") @default(auto()) @db.ObjectId
  postId         String    @map("post_id") @db.ObjectId
  post           Post?     @relation(fields: [postId], references: [id])
  userId         String    @map("user_id") @db.ObjectId
  user           User?     @relation(fields: [userId], references: [id])
  content        String
  likeCount      Int       @map("like_count") @default(0)
  sentimentScore Float?    @map("sentiment_score")
  parentId       String?   @map("parent_id") @db.ObjectId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([userId])
}

model Review {
  id             String    @id @map("_id") @default(auto()) @db.ObjectId
  movieId        String?   @map("movie_id")  @db.ObjectId
  seriesId       String?   @map("series_id") @db.ObjectId
  userId         String    @map("user_id") @db.ObjectId
  user           User?     @relation(fields: [userId], references: [id])
  content        String
  rating         Float?
  moodTag        MoodTag?
  likeCount      Int       @map("like_count") @default(0)
  sentimentScore Float?    @map("sentiment_score")
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([movieId])
  @@index([seriesId])
}

model SentimentLog {
  id         String      @id @map("_id") @default(auto()) @db.ObjectId
  targetType TargetType  @map("target_type")
  targetId   String      @map("target_id") @db.ObjectId
  userId     String      @map("user_id") @db.ObjectId
  sentiment  Sentiment
  score      Float
  timestamp  DateTime    @default(now())

  @@index([targetType, targetId])
  @@index([userId])
}

enum MediaType {
  MOVIE
  TV
}