// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String        @id @default(cuid())
  username           String        @unique
  name               String?
  email              String        @unique
  password           String?
  provider           String?
  googleId           String?       @unique
  avatarUrl          String?
  age                Int?
  preferredGenres    String[]      @default([])
  preferredLanguages String[]      @default([])
  reviewWarningScore Int           @default(0)
  reviewBannedUntil  DateTime?
  reviewCount        Int           @default(0)
  discloseProfileInfo Boolean      @default(true)
  discloseWatchlist   Boolean      @default(false)
  discloseReviews     Boolean      @default(true)
  discloseLiked       Boolean      @default(false)
  discloseBadges      Boolean      @default(true)
  discloseRecentActivity Boolean   @default(true)
  createdAt          DateTime      @default(now())
  Quiz               Quiz[]
  watchlistItems     WatchlistItem[]
  likedItems         LikedItem[]
  reviews            Review[]
  reviewReplies      ReviewReply[]
  reviewReactions    ReviewReaction[]
  reviewReplyReactions ReviewReplyReaction[]
  communityPosts     CommunityPost[]
  communityReplies   CommunityReply[]
  communityPostReactions CommunityPostReaction[]
  communityReplyReactions CommunityReplyReaction[]
  userAchievements   UserAchievement[]
  authVersion        Int           @default(0)
  authSessions       AuthSession[]
  achievementAccount AchievementAccount?
  achievementEvents AchievementEvent[]
  achievementFacts AchievementFact[]
  achievementMetrics AchievementMetric[]
  achievementAwards AchievementAwardLog[]
  achievementNotifications AchievementNotification[]
  watchedTitles WatchedTitle[]
  quizCompletions QuizCompletion[]
}

model AuthSession {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String   @unique
  previousTokenHash  String?  @unique
  previousValidUntil DateTime?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Lookups filter by email(+code); the cleanup job filters by expiresAt. Without
  // these every verify/request was a full table scan that worsened as rows piled up.
  @@index([email, code])
  @@index([expiresAt])
}

model Quiz {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    Json
  resultMood String
  createdAt  DateTime @default(now())
  completion QuizCompletion?

  @@index([userId, createdAt])
}

model Achievement {
  id                String            @id @default(uuid())
  key               String            @unique
  title             String
  description       String
  category          String
  requirementType   String
  requirementTarget String
  requiredCount     Int?
  progressLogic     String
  reasoningTemplate String
  lockedHint        String
  active            Boolean           @default(true)
  ruleVersion       Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  badge             BadgeDefinition?
  userProgress      UserAchievement[]
  ruleVersions      AchievementRuleVersion[]
  awards            AchievementAwardLog[]

  @@index([category])
  @@index([active])
  @@map("achievements")
}

model BadgeDefinition {
  id                  String      @id @default(uuid())
  key                 String      @unique
  achievementId       String      @unique
  achievement         Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  badgeName           String
  icon                String
  rarity              String
  mascotMood          String
  mascotMotion        String
  colorTheme          Json
  lockedVisualState   Json
  unlockedVisualState Json
  displayOrder        Int
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([rarity])
  @@index([displayOrder])
  @@index([active])
  @@map("badge_definitions")
}

model UserAchievement {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId        String
  achievement          Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  currentProgress      Int         @default(0)
  completionPercentage Float       @default(0)
  unlocked             Boolean     @default(false)
  unlockedAt           DateTime?
  relatedActivityRef   String?
  ruleVersion          Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([unlocked])
  @@map("user_achievements")
}

model AchievementRuleVersion {
  id String @id @default(uuid())
  achievementId String
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  version Int
  target String
  requiredCount Int?
  definition Json
  publishedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([achievementId, version])
  @@map("achievement_rule_versions")
}

model AchievementAccount {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone String?
  nextSequence BigInt @default(0)
  projectedSequence BigInt @default(0)
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("achievement_accounts")
}

model AchievementEvent {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequence BigInt
  kind String
  key String
  payload Json
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  status String @default("pending")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String?
  leaseUntil DateTime? @db.Timestamptz(3)
  errorCode String?
  processedAt DateTime? @db.Timestamptz(3)
  facts AchievementFact[]
  awards AchievementAwardLog[]

  @@unique([userId, sequence])
  @@unique([userId, key])
  @@index([status, availableAt])
  @@index([status, leaseUntil])
  @@index([status, processedAt])
  @@index([userId, status, sequence])
  @@map("achievement_events")
}

model AchievementFact {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric String
  key String
  day String? @db.VarChar(10)
  details Json @default("{}")
  occurredAt DateTime @db.Timestamptz(3)
  sourceEventId String?
  sourceEvent AchievementEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@unique([userId, metric, key])
  @@index([userId, metric, day])
  @@index([sourceEventId])
  @@map("achievement_facts")
}

model AchievementMetric {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric String
  value Int @default(0)
  lastSequence BigInt @default(0)

  @@id([userId, metric])
  @@map("achievement_metrics")
}

model AchievementAwardLog {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  ruleVersion Int
  action String
  actor String
  reason String @db.VarChar(500)
  evidence Json
  idempotencyKey String @unique
  sourceEventId String?
  sourceEvent AchievementEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  notification AchievementNotification?

  @@index([userId, createdAt])
  @@index([achievementId])
  @@index([sourceEventId])
  @@map("achievement_award_log")
}

model AchievementNotification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  awardId String @unique
  award AchievementAwardLog @relation(fields: [awardId], references: [id], onDelete: Cascade)
  seenAt DateTime? @db.Timestamptz(3)
  leaseToken String?
  leaseUntil DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, seenAt, leaseUntil])
  @@map("achievement_notifications")
}

model WatchedTitle {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId Int
  mediaType MediaType
  watchedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, watchedAt])
  @@map("watched_titles")
}

model QuizCompletion {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId String @unique
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptId String
  quizType String
  version String
  completedDay String @db.VarChar(10)
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, attemptId])
  @@unique([userId, quizType, completedDay])
  @@map("quiz_completions")
}

model AchievementTitleSnapshot {
  key String @id
  metadata Json
  fetchedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([fetchedAt])
  @@map("achievement_title_snapshots")
}

model AchievementTrendSnapshot {
  id String @id @default(uuid())
  keys String[]
  capturedAt DateTime @db.Timestamptz(3)
  validUntil DateTime @db.Timestamptz(3)

  @@index([capturedAt, validUntil])
  @@map("achievement_trend_snapshots")
}

// One row per saved/liked title (replaced the legacy Watchlist/LikedList array
// columns): membership is an indexed point lookup, writes don't rewrite a whole
// array, and the list can be paginated.
model WatchlistItem {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  mediaType MediaType
  addedAt   DateTime  @default(now())

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, addedAt])
  @@map("watchlist_items")
}

model LikedItem {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  mediaType MediaType
  addedAt   DateTime  @default(now())

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, addedAt])
  @@map("liked_items")
}

model Review {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId        Int
  mediaType     MediaType
  rating        Int           @db.SmallInt
  content       String
  moodEmojis    String[]
  status        ReviewStatus  @default(PUBLISHED)
  flaggedReason String?
  toxicityScore Float?
  profanityHit  Boolean       @default(false)
  affectsRating Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  replies       ReviewReply[]
  reactions     ReviewReaction[]

  @@index([tmdbId, mediaType])
  @@index([userId, status])
  @@index([rating])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  reactions ReviewReplyReaction[]

  @@index([reviewId])
  @@map("review_replies")
}

model ReviewReaction {
  id        String       @id @default(uuid())
  reviewId  String
  review    Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([reviewId, userId])
  @@index([reviewId, type])
  @@index([userId])
  @@map("review_reactions")
}

model ReviewReplyReaction {
  id        String       @id @default(uuid())
  replyId   String
  reply     ReviewReply  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([replyId, userId])
  @@index([replyId, type])
  @@index([userId])
  @@map("review_reply_reactions")
}

model CommunityPost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(120)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  replies   CommunityReply[]
  reactions CommunityPostReaction[]

  @@index([createdAt, id])
  @@index([userId])
  @@map("community_posts")
}

model CommunityReply {
  id        String   @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reactions CommunityReplyReaction[]

  @@index([postId, createdAt, id])
  @@index([userId])
  @@map("community_replies")
}

model CommunityPostReaction {
  id        String   @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId, type])
  @@index([userId])
  @@map("community_post_reactions")
}

model CommunityReplyReaction {
  id        String   @id @default(uuid())
  replyId   String
  reply     CommunityReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([replyId, userId])
  @@index([replyId, type])
  @@index([userId])
  @@map("community_reply_reactions")
}

model Mood {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String
  icon        String
  description String
  keywords    String[]
  tmdbGenres  Int[]
  valence     Decimal  @default(0) @db.Decimal(3, 2)
  arousal     Decimal  @default(0) @db.Decimal(3, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  logs            MoodLog[]
  recommendations Recommendation[]

  @@map("moods")
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  moodId    String
  intensity Int      @default(5)
  tags      String[]
  context   String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, moodId])
  @@map("mood_logs")
}

model Recommendation {
  id           String    @id @default(uuid())
  userId       String
  moodId       String
  tmdbId       Int
  mediaType    MediaType
  title        String
  overview     String?
  genreIds     Int[]
  voteAverage  Decimal   @db.Decimal(3, 2)
  voteCount    Int
  releaseDate  String?
  posterPath   String?
  backdropPath String?
  score        Decimal   @db.Decimal(4, 3)
  reason       String
  algorithm    String
  metadata     Json?
  viewed       Boolean   @default(false)
  liked        Boolean   @default(false)
  saved        Boolean   @default(false)
  rating       Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@unique([userId, moodId, tmdbId, mediaType])
  @@index([userId, moodId])
  @@index([score])
  @@index([createdAt])
  @@index([tmdbId, mediaType])
  @@map("recommendations")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String
  preferredGenres  Int[]
  dislikedGenres   Int[]
  preferredMoods   String[]
  minRating        Decimal  @default(6.0) @db.Decimal(3, 2)
  preferredRuntime Json? // {min: number, max: number}
  languages        String[] @default(["en"])
  includeAdult     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId])
  @@map("user_preferences")
}

// ─── L2 cache (Supabase) for TMDB-derived data ────────────────────────────
// These store the fully-assembled service responses as JSON so they survive
// Redis eviction. Redis stays the hot L1; Postgres is the permanent source of
// truth, refreshed via the fetchedAt staleness check.

// Five shared landing-page previews, independent of user recommendations.
model MoodNightPreview {
  choice    String   @id
  payload   Json
  expiresAt DateTime
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mood_night_previews")
}

model MediaDetail {
  id         String    @id @default(uuid())
  tmdbId     Int
  mediaType  MediaType
  title      String
  popularity Float?
  payload    Json // full movieDetails()/tvDetails() output: { info, credits, trailer, providers }
  fetchedAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tmdbId, mediaType])
  @@index([fetchedAt])
  @@map("media_details")
}

model TvSeasonBundle {
  id        String   @id @default(uuid())
  tmdbId    Int      @unique
  payload   Json // fetchSeasonsWithEpisodes() output: seasons[] with episodes
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fetchedAt])
  @@map("tv_season_bundles")
}

model RecommendationCache {
  id        String    @id @default(uuid())
  tmdbId    Int
  mediaType MediaType
  limit     Int
  payload   Json // mapped recommendation list
  fetchedAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tmdbId, mediaType, limit])
  @@index([fetchedAt])
  @@map("recommendation_cache")
}

// Per-content engagement counters, maintained incrementally on each
// like/save/review mutation (never recomputed by scanning). Row is created on
// first interaction; absent row = all counts 0.
model MediaStat {
  tmdbId      Int
  mediaType   MediaType
  likeCount   Int      @default(0)
  savedCount  Int      @default(0)
  reviewCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([tmdbId, mediaType])
  @@map("media_stats")
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  REJECTED // not used for now, will be used with IBM MAX toxicity detection ML Modal
}

enum MediaType {
  MOVIE
  TV
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}
