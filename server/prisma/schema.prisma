// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String        @id @default(cuid())
  username           String        @unique
  name               String?
  email              String        @unique
  password           String?
  provider           String?
  googleId           String?       @unique
  avatarUrl          String?
  age                Int?
  preferredGenres    String[]      @default([])
  preferredLanguages String[]      @default([])
  reviewWarningScore Int           @default(0)
  reviewBannedUntil  DateTime?
  reviewCount        Int           @default(0)
  discloseProfileInfo Boolean      @default(true)
  discloseWatchlist   Boolean      @default(false)
  discloseReviews     Boolean      @default(true)
  discloseLiked       Boolean      @default(false)
  discloseBadges      Boolean      @default(true)
  discloseRecentActivity Boolean   @default(true)
  createdAt          DateTime      @default(now())
  Quiz               Quiz[]
  Watchlist          Watchlist[]
  LikedList          LikedList?
  reviews            Review[]
  reviewReplies      ReviewReply[]
  userAchievements   UserAchievement[]
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Lookups filter by email(+code); the cleanup job filters by expiresAt. Without
  // these every verify/request was a full table scan that worsened as rows piled up.
  @@index([email, code])
  @@index([expiresAt])
}

model Quiz {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  answers    Json
  resultMood String
  createdAt  DateTime @default(now())
}

model Achievement {
  id                String            @id @default(uuid())
  key               String            @unique
  title             String
  description       String
  category          String
  requirementType   String
  requirementTarget String
  requiredCount     Int?
  progressLogic     String
  reasoningTemplate String
  lockedHint        String
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  badge             BadgeDefinition?
  userProgress      UserAchievement[]

  @@index([category])
  @@index([active])
  @@map("achievements")
}

model BadgeDefinition {
  id                  String      @id @default(uuid())
  key                 String      @unique
  achievementId       String      @unique
  achievement         Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  badgeName           String
  icon                String
  rarity              String
  mascotMood          String
  mascotMotion        String
  colorTheme          Json
  lockedVisualState   Json
  unlockedVisualState Json
  displayOrder        Int
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([rarity])
  @@index([displayOrder])
  @@index([active])
  @@map("badge_definitions")
}

model UserAchievement {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId        String
  achievement          Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  currentProgress      Int         @default(0)
  completionPercentage Float       @default(0)
  unlocked             Boolean     @default(false)
  unlockedAt           DateTime?
  relatedActivityRef   String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([unlocked])
  @@map("user_achievements")
}

model Watchlist {
  id       String   @id @default(uuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id])
  movieId  String[] @default([])
  seriesId String[] @default([])
  addedAt  DateTime @default(now())
}

model LikedList {
  id       String   @id @default(uuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id])
  movieId  String[] @default([])
  seriesId String[] @default([])
  addedAt  DateTime @default(now())
}

model Review {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId        Int
  mediaType     MediaType
  rating        Int           @db.SmallInt
  content       String
  moodEmojis    String[]
  status        ReviewStatus  @default(PUBLISHED)
  flaggedReason String?
  toxicityScore Float?
  profanityHit  Boolean       @default(false)
  affectsRating Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  replies       ReviewReply[]

  @@index([tmdbId, mediaType])
  @@index([rating])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@map("review_replies")
}

model Mood {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String
  icon        String
  description String
  keywords    String[]
  tmdbGenres  Int[]
  valence     Decimal  @default(0) @db.Decimal(3, 2)
  arousal     Decimal  @default(0) @db.Decimal(3, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  logs            MoodLog[]
  recommendations Recommendation[]

  @@map("moods")
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  moodId    String
  intensity Int      @default(5)
  tags      String[]
  context   String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, moodId])
  @@map("mood_logs")
}

model Recommendation {
  id           String    @id @default(uuid())
  userId       String
  moodId       String
  tmdbId       Int
  mediaType    MediaType
  title        String
  overview     String?
  genreIds     Int[]
  voteAverage  Decimal   @db.Decimal(3, 2)
  voteCount    Int
  releaseDate  String?
  posterPath   String?
  backdropPath String?
  score        Decimal   @db.Decimal(4, 3)
  reason       String
  algorithm    String
  metadata     Json?
  viewed       Boolean   @default(false)
  liked        Boolean   @default(false)
  saved        Boolean   @default(false)
  rating       Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@unique([userId, moodId, tmdbId, mediaType])
  @@index([userId, moodId])
  @@index([score])
  @@index([createdAt])
  @@index([tmdbId, mediaType])
  @@map("recommendations")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String
  preferredGenres  Int[]
  dislikedGenres   Int[]
  preferredMoods   String[]
  minRating        Decimal  @default(6.0) @db.Decimal(3, 2)
  preferredRuntime Json? // {min: number, max: number}
  languages        String[] @default(["en"])
  includeAdult     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId])
  @@map("user_preferences")
}

// ─── L2 cache (Supabase) for TMDB-derived data ────────────────────────────
// These store the fully-assembled service responses as JSON so they survive
// Redis eviction. Redis stays the hot L1; Postgres is the permanent source of
// truth, refreshed via the fetchedAt staleness check.

model MediaDetail {
  id         String    @id @default(uuid())
  tmdbId     Int
  mediaType  MediaType
  title      String
  popularity Float?
  payload    Json // full movieDetails()/tvDetails() output: { info, credits, trailer, providers }
  fetchedAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tmdbId, mediaType])
  @@index([fetchedAt])
  @@map("media_details")
}

model TvSeasonBundle {
  id        String   @id @default(uuid())
  tmdbId    Int      @unique
  payload   Json // fetchSeasonsWithEpisodes() output: seasons[] with episodes
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fetchedAt])
  @@map("tv_season_bundles")
}

model RecommendationCache {
  id        String    @id @default(uuid())
  tmdbId    Int
  mediaType MediaType
  limit     Int
  payload   Json // mapped recommendation list
  fetchedAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tmdbId, mediaType, limit])
  @@index([fetchedAt])
  @@map("recommendation_cache")
}

// Per-content engagement counters, maintained incrementally on each
// like/save/review mutation (never recomputed by scanning). Row is created on
// first interaction; absent row = all counts 0.
model MediaStat {
  tmdbId      Int
  mediaType   MediaType
  likeCount   Int      @default(0)
  savedCount  Int      @default(0)
  reviewCount Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([tmdbId, mediaType])
  @@map("media_stats")
}

enum ReviewStatus {
  PUBLISHED
  FLAGGED
  REJECTED // not used for now, will be used with IBM MAX toxicity detection ML Modal
}

enum MediaType {
  MOVIE
  TV
}
