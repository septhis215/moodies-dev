// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  username           String      @unique
  email              String      @unique
  password           String?
  provider           String?
  googleId           String?     @unique
  avatarUrl          String?
  age                Int?
  preferredGenres    String[]    @default([])
  preferredLanguages String[]    @default([])
  createdAt          DateTime    @default(now())
  Quiz               Quiz[]
  Badge              Badge[]
  Watchlist          Watchlist[]
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Quiz {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  answers    Json
  resultMood String
  createdAt  DateTime @default(now())
}

model Badge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeType String
  awardedAt DateTime @default(now())
}

model Watchlist {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  movieId  String[] @default([])
  seriesId String[] @default([])
  addedAt  DateTime @default(now())
}

model Series {
  id          String   @id @default(uuid())
  tmdbId      String   @unique
  title       String
  overview    String
  posterUrl   String?
  backdropUrl String?
  releaseDate String?
  genres      String[] @default([])
  rating      Float?
  moodTags    String[] @default([])
  createdAt   DateTime @default(now())
}

model Movie {
  id          String   @id @default(uuid())
  tmdbId      String   @unique
  title       String
  overview    String
  posterUrl   String?
  backdropUrl String?
  releaseDate String?
  genres      String[] @default([])
  rating      Float?
  moodTags    String[] @default([])
  createdAt   DateTime @default(now())
}

model Mood {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String
  icon        String
  description String
  keywords    String[]
  tmdbGenres  Int[]
  valence     Decimal  @default(0) @db.Decimal(3, 2)
  arousal     Decimal  @default(0) @db.Decimal(3, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  logs            MoodLog[]
  recommendations Recommendation[]

  @@map("moods")
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  moodId    String
  intensity Int      @default(5)
  tags      String[]
  context   String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, moodId])
  @@map("mood_logs")
}

model Recommendation {
  id           String    @id @default(uuid())
  userId       String
  moodId       String
  tmdbId       Int
  mediaType    MediaType
  title        String
  overview     String?
  genreIds     Int[]
  voteAverage  Decimal   @db.Decimal(3, 2)
  voteCount    Int
  releaseDate  String?
  posterPath   String?
  backdropPath String?
  score        Decimal   @db.Decimal(4, 3)
  reason       String
  algorithm    String
  metadata     Json?
  viewed       Boolean   @default(false)
  liked        Boolean   @default(false)
  saved        Boolean   @default(false)
  rating       Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@index([userId, moodId])
  @@index([score])
  @@index([createdAt])
  @@index([tmdbId, mediaType])
  @@map("recommendations")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String
  preferredGenres  Int[]
  dislikedGenres   Int[]
  preferredMoods   String[]
  minRating        Decimal  @default(6.0) @db.Decimal(3, 2)
  preferredRuntime Json? // {min: number, max: number}
  languages        String[] @default(["en"])
  includeAdult     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId])
  @@map("user_preferences")
}

model ContentCache {
  id               String    @id @default(uuid())
  tmdbId           Int
  mediaType        MediaType
  title            String
  overview         String?
  genreIds         Int[]
  voteAverage      Decimal   @db.Decimal(3, 2)
  voteCount        Int
  releaseDate      String?
  posterPath       String?
  backdropPath     String?
  popularity       Decimal   @db.Decimal(8, 3)
  adult            Boolean   @default(false)
  originalLanguage String
  metadata         Json?
  lastFetched      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tmdbId, mediaType])
  @@index([genreIds])
  @@index([voteAverage])
  @@index([popularity])
  @@index([lastFetched])
  @@map("content_cache")
}

enum MediaType {
  MOVIE
  TV
}
