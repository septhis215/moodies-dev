# Runtime
NODE_ENV="development"
PORT="4000"
CLIENT_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
TRUST_PROXY="false"
GIT_COMMIT_SHA=""

# Required
JWT_SECRET="replace-with-at-least-32-random-characters"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodies?schema=public"

# Optional Prisma direct connection for migration-capable hosts.
DIRECT_URL=""

# Auth cookies
JWT_ACCESS_EXPIRES="15m"
REFRESH_EXPIRES_DAYS="30"
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# Redis
# Prefer REDIS_URL when Dokploy provides an internal connection URL.
REDIS_URL=""
# TMDB
TMDB_API_KEY=""
TMDB_BASE="https://api.themoviedb.org/3"

# Celebrity media: optional; TMDB works without YouTube credentials.
YOUTUBE_API_KEY=""
YOUTUBE_DAILY_SEARCH_LIMIT="60"
YOUTUBE_REGION_CODE=""
CELEBRITY_MEDIA_USER_AGENT="Moodies/1.0 (moodies.support@gmail.com)"
# Optional identity hints keyed by TMDB person ID. Only confirmed channel IDs.
# Example shape: {"123":{"contexts":["Artist group"],"aliases":["Stage name"],"officialChannelIds":["UC..."]}}
CELEBRITY_MEDIA_IDENTITIES="{}"

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=""
TURNSTILE_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"
TURNSTILE_COOKIE_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Email
RESEND_API_KEY=""
MAIL_FROM="Moodies <onboarding@resend.dev>"
MAIL_USER=""
MAIL_PASS=""
MAIL_SUPPORT="moodies.support@gmail.com"

# Avatar storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
AVATAR_BUCKET="avatars"
