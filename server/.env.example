# Runtime
NODE_ENV="development"
PORT="4000"
CLIENT_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
TRUST_PROXY="false"

# Required
JWT_SECRET="replace-with-at-least-32-random-characters"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodies?schema=public"

# Optional Prisma direct connection for migration-capable hosts.
DIRECT_URL=""

# Auth cookies
JWT_ACCESS_EXPIRES="15m"
REFRESH_EXPIRES_DAYS="30"
COOKIE_SAMESITE="lax"
COOKIE_SECURE="false"
COOKIE_DOMAIN=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASS=""

# TMDB
TMDB_API_KEY=""
TMDB_BASE="https://api.themoviedb.org/3"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Email
RESEND_API_KEY=""
MAIL_FROM="Moodies <onboarding@resend.dev>"
MAIL_USER=""
MAIL_PASS=""
MAIL_SUPPORT="moodies.support@gmail.com"

# Avatar storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
AVATAR_BUCKET="avatars"
