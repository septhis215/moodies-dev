server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    # When Cloudflare proxies this host, configure real_ip_header and
    # set_real_ip_from with ONLY Cloudflare's published networks first.
    # Never use set_real_ip_from 0.0.0.0/0. See BOT_PROTECTION.md.

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace client-supplied forwarding chains at this public boundary.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
