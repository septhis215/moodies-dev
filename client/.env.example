# Copy this file to .env once. Do not edit the host URL when switching targets;
# use `npm run dev:local`, `npm run dev:staging`, or the matching build command.
LOCAL_API_URL="http://localhost:4000/api"
STAGING_API_URL="https://dev.api.moodies.tech/api"
PRODUCTION_API_URL="https://api.example.com/api"
NEXT_PUBLIC_SUPPORT_EMAIL="moodies.support@gmail.com"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
NEXT_PUBLIC_APP_ENV="local"

# Optional image base override.
NEXT_PUBLIC_TMDB_IMAGE_BASE="https://image.tmdb.org/t/p"

# Optional performance endpoint. Leave empty to keep metrics local-only.
NEXT_PUBLIC_PERFORMANCE_ENDPOINT=""
# Enable the built-in endpoint only when server logs are being collected.
PERFORMANCE_LOGGING="false"
