# Local backend. Safe defaults for development.
NEST_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SUPPORT_EMAIL="moodies.support@gmail.com"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Optional image base override.
NEXT_PUBLIC_TMDB_IMAGE_BASE="https://image.tmdb.org/t/p"

# Optional performance endpoint. Leave empty to keep metrics local-only.
NEXT_PUBLIC_PERFORMANCE_ENDPOINT=""
# Enable the built-in endpoint only when server logs are being collected.
PERFORMANCE_LOGGING="false"
